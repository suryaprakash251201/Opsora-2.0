# ── Opsora environment ──────────────────────────────────────────────
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development
PORT=4100
HOST=0.0.0.0

# Database
DATABASE_URL=file:./data/opsora.db

# Auth (API token for agent + optional UI bearer)
OPSORA_API_TOKEN=change-me-in-production
OPSORA_SESSION_SECRET=change-me-32-chars-minimum-please

# Frontend -> API
VITE_API_URL=http://localhost:4100

# Docker (local socket; leave empty to show Not Connected honestly)
DOCKER_SOCKET=/var/run/docker.sock
# DOCKER_HOST=tcp://192.168.1.10:2375

# Pi-hole
PIHOLE_URL=
PIHOLE_API_TOKEN=

# GitHub (server-side only — never expose to frontend)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOS=

# Tailscale
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# S3-compatible storage (server-side only)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Linux agent ingest
AGENT_INGEST_TOKEN=change-me-agent-token

# Realtime / polling defaults (ms)
METRICS_POLL_MS=5000
SERVICE_POLL_MS=30000
DISCOVERY_POLL_MS=120000
